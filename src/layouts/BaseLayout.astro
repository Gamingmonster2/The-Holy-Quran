---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.jsx';
import ThemeToggle from '../components/ThemeToggle.jsx';
import { resolveAsset } from '../lib/content.mjs';
import { t, translations } from '../lib/i18n.mjs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: unknown;
  robots?: string;
  bodyClass?: string;
  wide?: boolean;
  lang?: 'ar' | 'en';
  alternates?: Array<{ lang: string; href: string }>;
}

const {
  title,
  description = '',
  canonical,
  ogImage = '',
  schema = null,
  robots = '',
  bodyClass = '',
  wide = false,
  lang = 'ar',
  alternates = [],
} = Astro.props;
const ui = translations(lang);
const site = Astro.site ? new URL(Astro.site).origin : 'https://quranbook.org';
const canonicalUrl = canonical
  ? (canonical.startsWith('http') ? canonical : site + canonical)
  : site + Astro.url.pathname;
const finalDescription = String(description || '').trim()
  || `${String(title || '').replace(/<[^>]+>/g, '').trim()} — ${ui.siteName}`.trim();
const pageSchema = schema || {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: String(title || '').replace(/<[^>]+>/g, '').trim(),
  description: finalDescription,
  url: canonicalUrl,
  inLanguage: lang,
  isPartOf: { '@type': 'WebSite', name: ui.siteName, url: site + '/' },
};
const logo = '/wp-content/uploads/2025/10/image_fx_create_an_elegant_and_simple_logo_for_a_qura33333333333-150x150.avif';
const ogPath = resolveAsset(ogImage || logo);
const ogUrl = ogPath ? (ogPath.startsWith('/') ? site + ogPath : ogPath) : '';

const primary = ui.nav.map(([label, href, external]) => ({ label, href, external: Boolean(external) }));
const footerSite = ui.footerSite;
const footerQuran = ui.footerQuran;
const footerSources = ui.footerSources;
---

<!doctype html>
<html lang={lang} dir={lang === 'en' ? 'ltr' : 'rtl'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href.startsWith('http') ? alt.href : site + alt.href} />)}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    {robots && <meta name="robots" content={robots} />}
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema).replace(/</g, '\\u003c')} />
    <link rel="alternate" type="application/rss+xml" title="quranbook.org" href="/feed.xml" />
    <!-- أصول إضافة Quran Gateway الأصلية (خط + تنسيق الآيات) -->
    <link rel="stylesheet" href="/quran-gateway/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function(){try{var t=localStorage.getItem('qb-theme');if(!t)t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.theme=t;}catch(e){}})();
    </script>
  </head>
  <body class:list={['qb-body', bodyClass]}>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>

    <header class="site-header">
      <div class:list={['header-inner', wide && 'header-wide']}>
        <a class="brand" href="/" aria-label={t(lang, 'homeAria')}>
          <img src={logo} alt="" width="46" height="46" loading="eager" />
          <span><strong>{ui.siteName}</strong><small>{ui.siteDomain}</small></span>
        </a>
        <nav class="main-nav" aria-label={t(lang, 'navAria')}>
          {primary.map((item) => (
            <a href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          {alternates.length > 0 && (
            <a class="qb-lang-switch" href={alternates.find((a) => a.lang !== lang)?.href} hreflang={alternates.find((a) => a.lang !== lang)?.lang}>
              {lang === 'ar' ? t(lang, 'languageEn') : t(lang, 'languageAr')}
            </a>
          )}
          <SearchBox client:idle lang={lang} />
          <ThemeToggle client:load />
        </div>
        <details class="mobile-menu">
          <summary aria-label={t(lang, 'menuAria')}>☰</summary>
          <div class="mobile-menu-panel">
            {primary.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href="/category/">{t(lang, 'categories')}</a>
            <a href="/tag/">{t(lang, 'tags')}</a>
          </div>
        </details>
      </div>
    </header>

    <main id="main" class:list={['site-main', wide && 'site-main-wide']}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src={logo} alt="" width="52" height="52" loading="lazy" />
          <h2>{ui.siteName}</h2>
          <p>{ui.siteDescription}</p>
        </div>
        <div class="footer-col">
          <h3>{t(lang, 'footerSiteHeading')}</h3>
          {footerSite.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
        <div class="footer-col">
          <h3>{t(lang, 'footerQuranHeading')}</h3>
          {footerQuran.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}
        </div>
        <div class="footer-col">
          <h3>{t(lang, 'footerSourcesHeading')}</h3>
          {footerSources.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}
        </div>
      </div>
      <div class="footer-bottom">
        <span>{t(lang, 'copyright')}</span>
        <span><a href="/sitemap.xml">{t(lang, 'sitemap')}</a> · <a href="/robots.txt">{lang === 'ar' ? 'ملف الروبوت' : 'robots.txt'}</a> · <a href="https://salah.com/" target="_blank" rel="noopener noreferrer">{t(lang, 'prayerTimes')}</a></span>
      </div>
    </footer>

    <!-- حماية نهائية لمحتوى ووردبريس القديم: توضع بعد المحتوى لتفوق أنماط Kadence المضمنة -->
    <style is:inline>
      :root {
        --global-palette1: #115c44;
        --global-palette2: #f7f8f5;
        --global-palette3: #16241f;
        --global-palette4: #1c7b5b;
        --global-palette5: #b8944c;
        --global-palette6: #52645d;
        --global-palette7: #eef2ee;
        --global-palette8: #ffffff;
        --global-palette9: #ffffff;
      }
      :root[data-theme='dark'] {
        --global-palette1: #6fd0a8;
        --global-palette2: #121d19;
        --global-palette3: #e8eee9;
        --global-palette4: #8be0bc;
        --global-palette5: #e7d6ac;
        --global-palette6: #b0c0b8;
        --global-palette7: #192722;
        --global-palette8: #15211c;
        --global-palette9: #e8eee9;
      }
      .qb-original-home .kb-row-layout-wrap {
        border-radius: 20px;
        overflow: hidden;
      }
      .qb-original-home .quran_gateway_by_sora,
      .quran_gateway_widget .quran_gateway_by_sora {
        background: var(--surface-2);
        border-color: var(--line);
        border-radius: 14px;
        padding: 14px 16px;
      }
      .qb-original-home .aya_ar_by_sora,
      .qb-original-home .aya_en_by_sora,
      .quran_gateway_widget .aya_ar,
      .quran_gateway_widget .aya_en { color: var(--ink); }
      .qb-original-home .sora_title { color: var(--green); }
      .qb-original-home .sora_name_by_sora,
      .quran_gateway_widget .sora_name { color: var(--gold); }
      :root[data-theme='dark'] .qb-original-home .kb-row-layout-wrap,
      :root[data-theme='dark'] .qb-original-home .kb-row-layout-wrap * {
        color: var(--ink) !important;
      }
      :root[data-theme='dark'] .qb-original-home .kb-row-layout-wrap {
        background-color: var(--surface) !important;
        background-image: linear-gradient(135deg, var(--surface), var(--bg-soft)) !important;
        border-color: var(--line) !important;
      }
      :root[data-theme='dark'] .qb-original-home .kt-row-layout-overlay {
        background: transparent !important;
        opacity: 0 !important;
        mix-blend-mode: normal !important;
      }
      :root[data-theme='dark'] .qb-original-home .kt-row-layout-top-sep svg path,
      :root[data-theme='dark'] .qb-original-home .kt-row-layout-bottom-sep svg path {
        fill: var(--line-strong) !important;
      }
      :root[data-theme='dark'] .qb-original-home mark.has-inline-color,
      :root[data-theme='dark'] .qb-original-home .has-inline-color {
        color: var(--ink) !important;
        background-color: transparent !important;
      }
      :root[data-theme='dark'] .qb-original-home .quran_gateway_by_sora,
      :root[data-theme='dark'] .quran_gateway_widget .quran_gateway_by_sora {
        background-color: var(--surface-2) !important;
        border-color: var(--line) !important;
      }
      :root[data-theme='dark'] .qb-original-home .aya_ar_by_sora,
      :root[data-theme='dark'] .qb-original-home .aya_en_by_sora,
      :root[data-theme='dark'] .quran_gateway_widget .aya_ar,
      :root[data-theme='dark'] .quran_gateway_widget .aya_en { color: var(--ink) !important; }
      :root[data-theme='dark'] .qb-original-home .sora_title { color: var(--green) !important; }
      :root[data-theme='dark'] .qb-original-home .sora_name_by_sora,
      :root[data-theme='dark'] .quran_gateway_widget .sora_name { color: var(--gold) !important; }
      :root[data-theme='dark'] .qb-original-home a { color: var(--green) !important; }
      :root[data-theme='dark'] .qb-original-home .kt-testimonial-text-wrap,
      :root[data-theme='dark'] .qb-original-home .kt-testimonial-name,
      :root[data-theme='dark'] .qb-original-home .kt-testimonial-occupation {
        background: var(--surface-2) !important;
        color: var(--ink) !important;
        border-color: var(--line) !important;
      }
    </style>
  </body>
</html>
