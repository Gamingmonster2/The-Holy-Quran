---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from './Sidebar.astro';
import PostCard from './PostCard.astro';
import FontControls from './FontControls.jsx';
import { t } from '../lib/i18n.mjs';
import {
  getCover, getCategoryNames, getTagNames, relatedPosts, plainText, getIntro,
} from '../lib/content.mjs';

interface Props { post: any; lang?: 'ar' | 'en'; }
const { post, lang = post.lang || 'ar' } = Astro.props;
const cover = getCover(post);
const categories = getCategoryNames(post, lang);
const tags = getTagNames(post, lang);
const related = relatedPosts(post, 4);
const intro = getIntro(post, 260, lang);
const words = plainText(post.html).split(/\s+/).filter(Boolean).length;
const reading = Math.max(1, Math.round(words / 220));
---

<BaseLayout
  title={post.seoTitle || post.title}
  description={post.seoDescription}
  canonical={post.canonical}
  ogImage={post.ogImage || cover}
  schema={post.schema}
  robots={post.robots}
  lang={lang}
  alternates={post.alternates || []}
>
  <div class="qb-layout">
    <div class="qb-content">
      <article class="qb-article">
        <nav class="breadcrumbs">
          <a href="/">{t(lang, 'home')}</a> /
          <a href="/blog/">{t(lang, 'articles')}</a> /
          {categories[0] && <span>{categories[0]}</span>}
        </nav>
        <header class="qb-article-header">
          <h1>{post.title}</h1>
          <div class="qb-article-meta">
            <span>{t(lang, 'lastUpdated')}: {(post.modified || post.date || '').slice(0, 10)}</span>
            {categories.map((c) => <span class="qb-chip">{c}</span>)}
            <span>{t(lang, 'readingMinutes')} {reading} {t(lang, 'minute')}</span>
          </div>
          {lang === 'en' && <p class="qb-translation-note">{t(lang, 'englishNote')}</p>}
        </header>

        <div class="qb-article-cover"><img src={cover} data-original-src={post.ogImage || ''} alt="" loading="eager" /></div>

        <div class="qb-actions">
          <div class="qb-font-controls"><FontControls client:idle lang={lang} /></div>
        </div>

        {intro && (
          <div class="qb-article-intro">
            <span class="qb-intro-label">{t(lang, 'intro')}</span>
            <p>{intro}</p>
          </div>
        )}

        <div class="prose-quran" set:html={post.html} />

        {tags.length > 0 && (
          <div class="qb-tags">
            {tags.map((tag) => <span class="qb-chip">{tag}</span>)}
          </div>
        )}
      </article>

      {related.length > 0 && (
        <section class="qb-section">
          <div class="qb-section-head">
            <div><h2 class="qb-section-title">{t(lang, 'related')}</h2></div>
            <a href="/blog/">{t(lang, 'allArticles')} ←</a>
          </div>
          <div class="qb-grid">
            {related.map((p) => <PostCard post={p} summary={false} lang={lang} />)}
          </div>
        </section>
      )}
    </div>
    <Sidebar showReader={true} lang={lang} />
  </div>
</BaseLayout>
