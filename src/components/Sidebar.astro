---
import { getPosts, getEnglishPosts, getTerms } from '../lib/content.mjs';
import { t } from '../lib/i18n.mjs';
import FontControls from './FontControls.jsx';

interface Props { showReader?: boolean; lang?: 'ar' | 'en'; }
const { showReader = false, lang = 'ar' } = Astro.props;
const source = lang === 'en' ? getEnglishPosts() : getPosts();
const posts = source
  .filter((p) => p.path !== '/blog/')
  .sort((a, b) => (a.modified < b.modified ? 1 : -1))
  .slice(0, 6);
const termName = (term) => (lang === 'en' && term.englishName) || term.name;
const categories = getTerms('categories').slice().sort((a, b) => b.count - a.count).slice(0, 14);
const tags = getTerms('tags').slice().sort((a, b) => b.count - a.count).slice(0, 24);
---

<aside class="qb-sidebar" aria-label={lang === 'en' ? 'Sidebar' : 'الشريط الجانبي'}>
  <div class="qb-quran-box">
    <h3>{t(lang, 'sidebarQuranTitle')}</h3>
    <p>{t(lang, 'sidebarQuranText')}</p>
    <a class="qb-btn qb-btn-ghost" href="/quranonline/">{t(lang, 'sidebarOpenRepo')}</a>
  </div>

  {showReader && (
    <div class="qb-widget">
      <h3 class="qb-widget-title">{t(lang, 'sidebarReader')}</h3>
      <FontControls client:idle lang={lang} />
    </div>
  )}

  <div class="qb-widget">
    <h3 class="qb-widget-title">{t(lang, 'sidebarLatest')}</h3>
    <div class="qb-mini-list">
      {posts.map((p) => <a href={p.path}>{p.title}</a>)}
    </div>
  </div>

  <div class="qb-widget">
    <h3 class="qb-widget-title">{t(lang, 'categories')}</h3>
    <div class="qb-mini-list">
      {categories.map((c) => <a href={c.path}>{termName(c)} <span class="qb-chip">{c.count}</span></a>)}
    </div>
    <a href="/category/" style="display:inline-block;margin-top:10px;font-size:13px;">{t(lang, 'allArticles')} →</a>
  </div>

  <div class="qb-widget">
    <h3 class="qb-widget-title">{t(lang, 'tags')}</h3>
    <div>{tags.map((t) => <span class="qb-chip" style="margin:3px;"><a href={t.path}>{termName(t)}</a></span>)}</div>
  </div>
</aside>
