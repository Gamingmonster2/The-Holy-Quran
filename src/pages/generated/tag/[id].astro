---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import BlurFade from '../../../components/BlurFade.jsx';
import { getTerms, postsInTerm } from '../../../lib/content.mjs';

export function getStaticPaths() {
  return getTerms('tags').map((term) => ({
    params: { id: String(term.id) },
    props: { term },
  }));
}

const { term } = Astro.props;
const posts = postsInTerm('tags', term.id, 24);
---

<BaseLayout
  title={`${term.name} Archives - Quran Book`}
  description={`مقالات موسومة بـ: ${term.name}`}
  canonical={`https://quranbook.org${term.path}`}
>
  <div class="qb-layout">
    <div class="qb-content">
      <BlurFade client:visible>
        <div class="qb-term-header">
          <nav class="breadcrumbs"><a href="/">الرئيسية</a> / <a href="/tag/">الوسوم</a> / <span>{term.name}</span></nav>
          <h1 class="qb-term-title">{term.name}</h1>
          <p>مقالات موسومة بـ: {term.name} — {posts.length} مقالة</p>
        </div>
      </BlurFade>
      <div class="qb-grid">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
      <p class="qb-panel-note">لعرض المزيد استخدم البحث في أعلى الصفحة أو تصفح <a href="/blog/">كل المقالات</a>.</p>
    </div>
    <Sidebar />
  </div>
</BaseLayout>
