---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTerms, getPosts } from '../../../lib/content.mjs';

export function getStaticPaths() {
  return getTerms('tags').map((term) => ({
    params: { id: String(term.id) },
    props: { term },
  }));
}

const { term } = Astro.props;
const posts = getPosts()
  .filter((p) => p.tags.includes(term.id))
  .sort((a, b) => (a.modified < b.modified ? 1 : -1));
---

<BaseLayout
  title={`${term.name} Archives - Quran Book`}
  description={`مقالات موسومة بـ: ${term.name}`}
  canonical={`https://quranbook.org${term.path}`}
>
  <div class="qb-list">
    <h1>وسم: {term.name}</h1>
    <p class="qb-meta">{posts.length} مقالة تحمل هذا الوسم</p>
    {posts.map((p) => (
      <a class="qb-card" href={p.path}>
        <b>{p.title}</b>
        <small>{p.modified}</small>
      </a>
    ))}
  </div>
</BaseLayout>
