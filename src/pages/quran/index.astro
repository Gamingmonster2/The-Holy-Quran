---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadQuranManifest } from '../../lib/quran-manifest.mjs';

const manifest = loadQuranManifest();
const title = 'المصحف الكامل – اقرأ واستمع إلى جميع السور | Quran Book';
const description = 'جميع سور القرآن الكريم الـ114 في صفحات مستقلة: قراءة كاملة، تلاوة صوتية آية بآية، وترجمات إلى الإنجليزية والفرنسية والألمانية.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://quranbook.org/' },
    { '@type': 'ListItem', position: 2, name: 'المصحف الكامل', item: 'https://quranbook.org/quran/' },
  ],
};
---

<BaseLayout
  wide
  title={title}
  description={description}
  canonical="/quran/"
  schema={schema}
>
  <nav class="qb-crumbs" aria-label="مسار التنقل">
    <a href="/">الرئيسية</a><span>/</span><span>المصحف الكامل</span>
  </nav>

  <section class="qb-surah-hero">
    <span class="qb-eyebrow">📖 المصحف الكامل</span>
    <h1>اقرأ واستمع إلى القرآن الكريم</h1>
    <p>اختر سورة لتفتحها في صفحة مستقلة كاملة: النص كاملاً، تلاوة آية بآية، وترجمات بثلاث لغات، بلا نوافذ منبثقة.</p>
    <p class="qb-surah-meta">114 سورة · 6,236 آية</p>
  </section>

  <section class="qb-section">
    <div class="qb-section-head">
      <div>
        <h2 class="qb-section-title">فهرس السور</h2>
        <p class="qb-section-sub">كل سورة تفتح في عنوان ثابت يمكن مشاركته والعودة إليه.</p>
      </div>
    </div>
    <div class="qb-surah-index">
      {manifest.map((surah) => (
        <a className="qb-index-item" href={`/quran/${surah.number}/`}>
          <span className="qb-surah-num">{surah.number}</span>
          <span class="qb-index-name">
            <strong>سورة {surah.nameAr}</strong>
            <small lang="en">{surah.nameEn}</small>
          </span>
          <span class="qb-index-count">{surah.verses} آية</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
