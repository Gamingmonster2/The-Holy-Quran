  "slug": "%d8%a5%d8%b5%d8%af%d8%a7%d8%b1%d8%a7%d8%aa-%d9%85%d8%b5%d8%ad%d9%81-%d8%ad%d9%81%d8%b5",
  "status": "publish",
  "link": "https://quranbook.org/%d8%a5%d8%b5%d8%af%d8%a7%d8%b1%d8%a7%d8%aa-%d9%85%d8%b5%d8%ad%d9%81-%d8%ad%d9%81%d8%b5/",
  "title": {
    "rendered": "إصدارات مصحف حفص"
  },
  "content": {
    "rendered": "\n<style>\n  /* الخلفية والخطوط */\n  .royal-dark-container {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    background-color: #121212;\n    color: #e0e0e0;\n    padding: 20px;\n    border-radius: 8px;\n    direction: rtl;\n    max-width: 100%;\n    margin: 0 auto;\n  }\n\n  /* القسم الرئيسي (المصحف الأول) */\n  .royal-hero {\n    background: #1e1e1e;\n    border: 1px solid #333;\n    border-radius: 8px;\n    padding: 20px;\n    margin-bottom: 40px;\n    box-shadow: 0 4px 20px rgba(0,0,0,0.5);\n    text-align: center;\n  }\n\n  .royal-hero h2 {\n    color: #d4af37; /* لون ذهبي */\n    margin-top: 0;\n    font-size: 24px;\n    border-bottom: 1px solid #333;\n    padding-bottom: 15px;\n    margin-bottom: 20px;\n  }\n\n  /* زر الفتح في نافذة جديدة (الذهبي) */\n  .royal-btn-gold {\n    display: block;\n    width: 100%;\n    max-width: 400px;\n    margin: 0 auto 20px auto;\n    padding: 12px 20px;\n    background: linear-gradient(45deg, #d4af37, #c5a028);\n    color: #000;\n    font-weight: bold;\n    text-decoration: none;\n    border-radius: 5px;\n    font-size: 16px;\n    transition: transform 0.2s;\n  }\n  .royal-btn-gold:hover {\n    transform: scale(1.02);\n    box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);\n  }\n\n  /* حاوية الآي فريم */\n  .royal-iframe-box {\n    position: relative;\n    padding-bottom: 56.25%;\n    height: 0;\n    overflow: hidden;\n    border: 1px solid #444;\n  }\n  .royal-iframe-box iframe {\n    position: absolute;\n    top: 0; left: 0; width: 100%; height: 100%; border: 0;\n  }\n\n  /* شبكة البطاقات (الشرائح) */\n  .royal-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n    gap: 20px;\n  }\n\n  /* تصميم البطاقة */\n  .royal-card {\n    background-color: #1e1e1e;\n    border: 1px solid #333;\n    border-radius: 8px;\n    padding: 20px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    transition: all 0.3s ease;\n    text-decoration: none; /* إزالة خط الرابط */\n    color: inherit;\n  }\n\n  .royal-card:hover {\n    border-color: #d4af37;\n    transform: translateY(-5px);\n    background-color: #252525;\n  }\n\n  .card-title {\n    color: #fff;\n    font-size: 18px;\n    font-weight: bold;\n    margin-bottom: 8px;\n  }\n\n  .card-desc {\n    color: #aaa;\n    font-size: 13px;\n    margin-bottom: 15px;\n    line-height: 1.5;\n  }\n\n  .card-action {\n    color: #d4af37;\n    font-size: 14px;\n    font-weight: bold;\n    text-align: left;\n    margin-top: auto; /* يدفع الزر للأسفل */\n  }\n\n</style>\n\n<div class=\"royal-dark-container\">\n\n  <div class=\"royal-hero\">\n    <h2>🕌 المصحف الممتاز (النسخة الكاملة)</h2>\n    \n    <a href=\"https://qurancomplex.gov.sa/quran-hafs/#flipbook-df_11311/1/\" target=\"_blank\" class=\"royal-btn-gold\">\n      ⎋ اضغط هنا لفتح المصحف بملء الشاشة (قراءة واضحة)\n    </a>\n\n    <div class=\"royal-iframe-box\">\n      <iframe src=\"https://qurancomplex.gov.sa/quran-hafs/#flipbook-df_11311/1/\" title=\"المصحف الممتاز\"></iframe>\n    </div>\n  </div>\n\n  <h3 style=\"color: #fff; border-bottom: 1px solid #333; padding-bottom: 10px;\">📚 إصدارات ونسخ أخرى:</h3>\n  <div id=\"royalGrid\" class=\"royal-grid\"></div>\n\n</div>\n\n<script>\n  // البيانات مع الوصف\n  const royalData = [\n    { n: \"المصحف الخاص 1\", i: \"11309\", d: \"نسخة خاصة بجودة عالية وطباعة فاخرة.\" },\n    { n: \"المصحف الجوامعي\", i: \"11305\", d: \"حجم كبير وخط واضح جداً، مناسب للمساجد وكبار السن.\" },\n    { n: \"المصحف الجوامعي – 3\", i: \"11552\", d: \"الإصدار الثالث من النسخة الجوامعية بخط كبير.\" },\n    { n: \"المصحف العادي\", i: \"11301\", d: \"الحجم القياسي المعتاد (الأخضر) المتوفر في أغلب الأماكن.\" },\n    { n: \"المصحف العادي – 3\", i: \"11299\", d: \"الإصدار الثالث من الحجم العادي بطباعة حديثة.\" },\n    { n: \"المصحف الوسط\", i: \"11297\", d: \"حجم متوسط، يجمع بين وضوح الخط وسهولة الحمل.\" },\n    { n: \"مصحف الجيب\", i: \"11295\", d: \"حجم صغير جداً، مثالي للحمل في الجيب أينما ذهبت.\" },\n    { n: \"المصحف الكفي\", i: \"11293\", d: \"بحجم كف اليد، أكبر قليلاً من الجيب وأصغر من الوسط.\" },\n    { n: \"مصحف نسخ إندوباك\", i: \"11291\", d: \"بالرسم العثماني (النسخ الآسيوي) المنتشر في شبه القارة الهندية.\" },\n    { n: \"ربع يس\", i: \"11289\", d: \"يحتوي على الربع الأخير من القرآن (من سورة يس).\" },\n    { n: \"جزء قد سمع\", i: \"11286\", d: \"الجزء الثامن والعشرون، للتلاوة والحفظ.\" },\n    { n: \"جزء تبارك\", i: \"11284\", d: \"الجزء التاسع والعشرون (جزء تبارك).\" },\n    { n: \"الفاتحة وجزء عم\", i: \"11282\", d: \"الجزء الثلاثون، مخصص لتعليم الصغار وقصار السور.\" }\n  ];\n\n  const royalContainer = document.getElementById('royalGrid');\n\n  royalData.forEach(item => {\n    const link = document.createElement('a');\n    link.href = `https://qurancomplex.gov.sa/quran-hafs/#flipbook-df_${item.i}/1/`;\n    link.target = \"_blank\";\n    link.className = 'royal-card';\n    \n    link.innerHTML = `\n      <div>\n        <div class=\"card-title\">${item.n}</div>\n        <div class=\"card-desc\">${item.d}</div>\n      </div>\n      <div class=\"card-action\">فتح النسخة ↗</div>\n    `;\n\n    royalContainer.appendChild(link);\n  });\n</script>\n",
    "protected": false
  },
  "excerpt": {
    "rendered": "<p>🕌 المصحف الممتاز (النسخة الكاملة) ⎋ اضغط هنا لفتح المصحف بملء الشاشة (قراءة واضحة) 📚 إصدارات&#8230;</p>\n",
