  "content": {
    "rendered": "\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"535\" src=\"https://quranbook.org/wp-content/uploads/2024/09/Design-6-1-1024x535.png\" alt=\"تنزيل مصحف الجماهيرية pdf\" class=\"wp-image-6657\" srcset=\"https://quranbook.org/wp-content/uploads/2024/09/Design-6-1-1024x535.png 1024w, https://quranbook.org/wp-content/uploads/2024/09/Design-6-1-300x157.png 300w, https://quranbook.org/wp-content/uploads/2024/09/Design-6-1-768x401.png 768w, https://quranbook.org/wp-content/uploads/2024/09/Design-6-1.png 1200w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\">مصحف الجماهيرية برواية قالون على الرسم الذي اختاره الإمام أبو عمرو الداني</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-full is-resized\"><a href=\"https://dn790005.ca.archive.org/0/items/sa71mir_gmail_20151126_0908/%D9%85%D8%B5%D8%AD%D9%81%20%D8%A7%D9%84%D8%AC%D9%85%D8%A7%D9%87%D9%8A%D8%B1%D9%8A%D8%A9%20%D8%A8%D8%B1%D9%88%D8%A7%D9%8A%D8%A9%20%D9%82%D8%A7%D9%84%D9%88%D9%86%20%D8%B9%D9%84%D9%89%20%D8%A7%D9%84%D8%B1%D8%B3%D9%85%20%D8%A7%D9%84%D8%B0%D9%8A%20%D8%A7%D8%AE%D8%AA%D8%A7%D8%B1%D9%87%20%D8%A7%D9%84%D8%A5%D9%85%D8%A7%D9%85%20%D8%A3%D8%A8%D9%88%20%D8%B9%D9%85%D8%B1%D9%88%20%D8%A7%D9%84%D8%AF%D8%A7%D9%86%D9%8A.pdf\" target=\"_blank\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" width=\"256\" height=\"256\" src=\"https://quranbook.org/wp-content/uploads/2024/04/PDF1.png\" alt=\"\" class=\"wp-image-5730\" style=\"width:78px;height:auto\" srcset=\"https://quranbook.org/wp-content/uploads/2024/04/PDF1.png 256w, https://quranbook.org/wp-content/uploads/2024/04/PDF1-150x150.png 150w\" sizes=\"auto, (max-width: 256px) 100vw, 256px\" /></a></figure>\n</div>\n\n\n<p class=\"wp-block-paragraph\"><strong><mark style=\"background-color:rgba(0, 0, 0, 0);colo