    "rendered": "تلاوات الاطفال"
  },
  "content": {
    "rendered": "<div class=\"wp-block-image is-style-rounded\">\n<figure class=\"aligncenter size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"768\" src=\"https://quranbook.org/wp-content/uploads/2024/05/the-quran-religious-book-of-islam-12715782-1024x768.jpg\" alt=\"The Quran, Religious Book of Islam-تلاوات الاطفال\" class=\"wp-image-5946\" style=\"width:415px;height:auto\" srcset=\"https://quranbook.org/wp-content/uploads/2024/05/the-quran-religious-book-of-islam-12715782-1024x768.jpg 1024w, https://quranbook.org/wp-content/uploads/2024/05/the-quran-religious-book-of-islam-12715782-300x225.jpg 300w, https://quranbook.org/wp-content/uploads/2024/05/the-quran-religious-book-of-islam-12715782-768x576.jpg 768w, https://quranbook.org/wp-content/uploads/2024/05/the-quran-religious-book-of-islam-12715782-1536x1152.jpg 1536w, https://quranbook.org/wp-content/uploads/2024/05/the-quran-religious-book-of-islam-12715782-2048x1536.jpg 2048w, https://quranbook.org/wp-content/uploads/2024/05/the-quran-religious-book-of-islam-12715782-500x375.jpg 500w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n</div>\n\n\n<h4 class=\"wp-block-heading\">سورة النمل &#8211; الآية [82 &#8211; 93]</h4>\n\n\n\n<h6 class=\"wp-block-heading\"><strong><a href=\"https://www.tvquran.com/ar/scholar/178/profile/%D8%AE%D8%A7%D9%84%D8%AF-%D8%B6%D8%A7%D9%88%D9%8A\">خالد ضاوي</a> / <a href=\"https://www.tvquran.com/ar/selections/category/7/%D8%AA%D9%84%D8%A7%D9%88%D8%A7%D8%AA-%D8%A7%D9%84%D8%A7%D8%B7%D9%81%D8%A7%D9%84\" target=\"_blank\" rel=\"noreferrer noopener\">تلاوات الاطفال</a></strong></h6>\n\n\n\n<p class=\"wp-block-paragraph\">تلاوات الاطفال</p>\n\n\n\n<p class=\"wp-block-paragraph\">تلاوة عذبة وخاشعة تنساب كالنسيم في فيديو: <strong>سورة النمل &#8211; الآية [82 &#8211; 93] تلاوه تريح القلب ❤ والعقل || سبحان من رزقه هذا الصوت خالد الضاوي</strong>. عالم من الطمأنينة والخشوع بتلاوة هادئة وخاشعة مميزة، لذة سماع القرآن الكريم وجمال التجويد، مع: <strong>سورة النمل &#8211; الآية [82 &#8211; 93] تلاوه تريح القلب ❤ والعقل || سبحان من رزقه هذا الصوت خالد الضاوي</strong>، تلاوة تأخذك في رحلة مليئة بالسكينة.</p>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\"  id=\"_ytid_56704\"  width=\"1290\" height=\"725\"  data-origwidth=\"1290\" data-origheight=\"725\" src=\"https://www.youtube.com/embed/bnbNrUDW5R0?enablejsapi=1&#038;autoplay=0&#038;cc_load_policy=0&#038;cc_lang_pref=&#038;iv_load_policy=1&#038;loop=0&#038;rel=1&#038;fs=1&#038;playsinline=0&#038;autohide=2&#038;theme=dark&#038;color=red&#038;controls=1&#038;disablekb=0&#038;\" class=\"__youtube_prefs__  epyt-is-override  no-lazyload\" title=\"YouTube player\"  allow=\"fullscreen; accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen data-no-lazy=\"1\" data-skipgform_ajax_framebjll=\"\"></iframe>\n</div></figure>\n\n\n\n<div dir=\"rtl\" style=\"text-align: right;\">\n<p>&nbsp; &nbsp;<iframe loading=\"lazy\" src=\"https://www.tvquran.com/ar/selections/author/178/embeddable\" width=\"825\" height=\"670\" frameborder=\"0\" scrolling=\"no\" align=\"center\"></iframe></p>\n</div>\n",
    "protected": false
  },
