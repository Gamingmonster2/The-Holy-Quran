  "content": {
    "rendered": "<div class=\"wp-block-image is-style-rounded\">\n<figure class=\"aligncenter size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"204\" height=\"204\" src=\"https://quranbook.org/wp-content/uploads/2024/05/images.jpg\" alt=\"منصور السالمي mp3\" class=\"wp-image-5929\" srcset=\"https://quranbook.org/wp-content/uploads/2024/05/images.jpg 204w, https://quranbook.org/wp-content/uploads/2024/05/images-150x150.jpg 150w\" sizes=\"auto, (max-width: 204px) 100vw, 204px\" /></figure>\n</div>\n\n\n<h3 class=\"wp-block-heading\">المعلومات:</h3>\n\n\n\n<figure class=\"wp-block-table\"><table><thead><tr><th>خاصية</th><th>تفاصيل</th></tr></thead><tbody><tr><td><strong>الاسم</strong></td><td>منصور السالمي</td></tr><tr><td><strong>الجنسية</strong></td><td>سعودي</td></tr><tr><td><strong>النوع</strong></td><td>تلاوات خاشعة</td></tr><tr><td><strong>مكان الولادة</strong></td><td>السعودية</td></tr><tr><td><strong>المهنة</strong></td><td>إمام مسجد، قارئ للقرآن الكريم</td></tr><tr><td><strong>أبرز الأعمال</strong></td><td>تسجيلات لتلاوات القرآن الكريم</td></tr><tr><td><strong>روابط التلاوات</strong></td><td><a href=\"https://www.youtube.com/results?search_query=%D9%85%D9%86%D8%B5%D9%88%D8%B1+%D8%A7%D9%84%D8%B3%D8%A7%D9%84%D9%85%D9%8A\">منصور السالمي على YouTube</a></td></tr></tbody></table><figcaption class=\"wp-element-caption\">منصور السالمي mp3</figcaption></figure>\n\n\n\n<div style=\"height:75px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-4-3 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\" title=\"سورة البقرة || القارئ منصور السالمي - Surah al‑Baqarah || Mansour Al-Salmi\" width=\"720\" height=\"405\" src=\"https://www.youtube.com/embed/TwvIjjup_Ao?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerp