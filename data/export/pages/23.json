    "rendered": "\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Digital Quran Repository | المستودع الرقمي للقرآن الكريم</title>\n    \n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&#038;family=Roboto:wght@300;400;700&#038;display=swap\" rel=\"stylesheet\">\n\n    <style>\n        :root {\n            --main-black: #111111;\n            --main-blue: #0056b3; /* Royal Blue */\n            --light-blue: #e6f2ff;\n            --white: #ffffff;\n        }\n\n        body {\n            font-family: 'Roboto', sans-serif;\n            margin: 0;\n            padding: 0;\n            background-color: #f4f4f4;\n            color: var(--main-black);\n        }\n\n        /* Header Styling */\n        header {\n            background-color: var(--main-black);\n            color: var(--white);\n            padding: 40px 20px;\n            text-align: center;\n            border-bottom: 5px solid var(--main-blue);\n        }\n\n        h1 {\n            margin: 0;\n            font-size: 2.5rem;\n            font-weight: 700;\n        }\n\n        .arabic-text {\n            font-family: 'Amiri', serif;\n            direction: rtl;\n        }\n\n        .subtitle {\n            color: var(--main-blue);\n            margin-top: 10px;\n            font-size: 1.2rem;\n        }\n\n        /* Container Styling */\n        .container {\n            max-width: 900px;\n            margin: 40px auto;\n            padding: 0 20px;\n        }\n\n        .info-card {\n            background: var(--white);\n            padding: 30px;\n            border-radius: 12px;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n            text-align: center;\n            margin-bottom: 30px;\n            border-top: 4px solid var(--main-black);\n        }\n\n        .reciter-badge {\n            display: inline-block;\n            background-color: var(--main-blue);\n            color: var(--white);\n            padding: 8px 16px;\n            border-radius: 50px;\n            font-weight: bold;\n            margin: 15px 0;\n        }\n\n        /* Verse List Styling */\n        .verse-list {\n            list-style: none;\n            padding: 0;\n        }\n\n        .verse-item {\n            background-color: var(--white);\n            border: 1px solid #ddd;\n            border-left: 6px solid var(--main-blue);\n            margin-bottom: 20px;\n            padding: 20px;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n        }\n\n        .verse-item:hover {\n            background-color: var(--light-blue);\n            transform: translateY(-3px);\n            box-shadow: 0 5px 15px rgba(0,86,179,0.2);\n        }\n\n        .verse-arabic {\n            font-family: 'Amiri', serif;\n            font-size: 1.8rem;\n            text-align: right;\n            color: var(--main-black);\n            line-height: 2.2rem;\n        }\n\n        .verse-english {\n            font-size: 1.1rem;\n            color: #555;\n            text-align: left;\n        }\n\n        /* Audio Controls Visuals */\n        .controls {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            border-top: 1px solid #eee;\n            padding-top: 15px;\n            margin-top: 10px;\n        }\n\n        .action-btn {\n            background: none;\n            border: 2px solid var(--main-blue);\n            color: var(--main-blue);\n            padding: 8px 15px;\n            border-radius: 5px;\n            cursor: pointer;\n            font-weight: bold;\n            font-size: 0.9rem;\n            transition: background 0.2s;\n        }\n\n        .action-btn:hover {\n            background-color: var(--main-blue);\n            color: var(--white);\n        }\n\n        /* Footer */\n        footer {\n            text-align: center;\n            padding: 20px;\n            background-color: var(--main-black);\n            color: #777;\n            font-size: 0.9rem;\n            margin-top: 50px;\n        }\n        \n        footer a {\n            color: var(--main-blue);\n            text-decoration: none;\n        }\n    </style>\n</head>\n<body>\n\n    <header>\n        <h1>Digital Quran Repository</h1>\n        <h1 class=\"arabic-text\">المستودع الرقمي للقرآن الكريم</h1>\n        <p class=\"subtitle\">Access Verses, Translations, and Guidance</p>\n    </header>\n\n    <div class=\"container\">\n        \n        <div class=\"info-card\">\n            <h2>Recitation Audio</h2>\n            <h2 class=\"arabic-text\">التلاوة الصوتية</h2>\n            \n            <div class=\"reciter-badge\">\n                Voice: Sheikh Mishary Al-Afasy | القارئ: الشيخ مشاري العفاسي\n            </div>\n            \n            <p>Click on any verse below to listen to the recitation or download the audio file.</p>\n            <p class=\"arabic-text\">اضغط على أي آية أدناه للاستماع إلى التلاوة أو تحميل الملف الصوتي.</p>\n        </div>\n\n        <ul class=\"verse-list\">\n            \n            <li class=\"verse-item\" onclick=\"playDemo('audio1')\">\n                <div class=\"verse-arabic\">\n                    بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ\n                </div>\n                <div class=\"verse-english\">\n                    In the name of Allah, the Entirely Merciful, the Especially Merciful.\n                </div>\n                <div class=\"controls\">\n                    <span style=\"font-size: 0.9rem; color: #666;\">Surah Al-Fatiha [1:1]</span>\n                    <div>\n                        <button class=\"action-btn\">▶ Play / تشغيل</button>\n                        <button class=\"action-btn\">⬇ Download / تحميل</button>\n                    </div>\n                </div>\n            </li>\n\n            <li class=\"verse-item\" onclick=\"playDemo('audio2')\">\n                <div class=\"verse-arabic\">\n                    ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ\n                </div>\n                <div class=\"verse-english\">\n                    [All] praise is [due] to Allah, Lord of the worlds.\n                </div>\n                <div class=\"controls\">\n                    <span style=\"font-size: 0.9rem; color: #666;\">Surah Al-Fatiha [1:2]</span>\n                    <div>\n                        <button class=\"action-btn\">▶ Play / تشغيل</button>\n                        <button class=\"action-btn\">⬇ Download / تحميل</button>\n                    </div>\n                </div>\n            </li>\n\n        </ul>\n    </div>\n\n    <footer>\n        <p>&copy; 2025 Digital Quran Repository. All rights reserved.</p>\n        <p class=\"arabic-text\">جميع الحقوق محفوظة للمستودع الرقمي للقرآن الكريم</p>\n    </footer>\n\n    <script>\n        // Simple script to simulate interaction\n        function playDemo(id) {\n            console.log(\"Interaction detected on verse: \" + id);\n            // In a real application, this would trigger the HTML5 Audio player\n        }\n    </script>\n\n</body>\n</html>\n\n\n<p><div class=\"quran_gateway_sora_list\"><h2 class=\"sora_title\">The Noble Qur'an</h2><ul><li>1. <a href=\"https://quranbook.org/quranonline/?language_id=1&sora_id=1\">Al-Fatihah ( The Opening )</a></li><li>2. <a href=\"https://quranbook.org/quranonline/?language_id=1&sora_id=2\">Al-Baqarah ( The Cow )</a></li><li>3. <a href=\"https://quranbook.org/quranonline/?language_id=1&sora_id=3\">Al-Imran ( The Famiy of Imran )</a></li><li>4. <a href=\"https://quranbook.org/quranonline/?language_id=1&sora_id=4\">An-Nisa ( The Women )</a></li><li>5. <a href=\"https://quranbook.org/quranonline/?language_